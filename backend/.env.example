# VidGuru AI Environment Configuration
PROJECT_NAME="VidGuru AI"

# LLM Providers (Add any of your API keys below)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Default Models
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# Security (optional but recommended for deployed demos)
VIDGURU_API_KEY=
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=15

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
