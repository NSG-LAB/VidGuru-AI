# VidGuru AI - Environment Variables Template
# Copy this file to .env and add your keys

# LLM Providers (Optional - built-in pedagogical fallbacks available)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

GROQ_API_KEY=""

# Server & Container Ports
BACKEND_PORT=8005
FRONTEND_PORT=3001

# Frontend API Endpoint (defaults to http://localhost:8005/api/v1)
NEXT_PUBLIC_API_BASE=http://localhost:8005/api/v1
